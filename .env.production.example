# ==============================================================================
# Stellar Payment Hub - Production Configuration Template (.env.production.example)
# ==============================================================================

# Server Network & Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://stellar-payment-hub.app,https://app.stellar-payment-hub.com

# Stellar & Soroban RPC Production Endpoints
STELLAR_NETWORK=public
STELLAR_HORIZON_URL=https://horizon.stellar.org
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# Smart Contract Addresses (Deployed on Stellar Mainnet)
PAYMENT_HUB_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SETTLEMENT_CONTRACT_ID=CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# Security, Admin & Webhook Secret Keys
ADMIN_API_KEY=replace-with-cryptographically-secure-64-character-hex-string
WEBHOOK_SIGNING_SECRET=replace-with-hmac-sha256-signing-secret-key-production

# Rate Limiting & Resource Protection
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_MS=60000
SSE_KEEP_ALIVE_INTERVAL_MS=15000

# Diagnostic & Observability
LOG_LEVEL=info
ENABLE_PROMETHEUS_METRICS=true
