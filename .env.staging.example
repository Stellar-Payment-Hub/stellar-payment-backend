# ==============================================================================
# Stellar Payment Hub - Staging Configuration Template (.env.staging.example)
# ==============================================================================

# Server Network & Runtime
NODE_ENV=staging
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://staging.stellar-payment-hub.app,http://localhost:5173

# Stellar & Soroban RPC Testnet Endpoints
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract Addresses (Staging Testnet Contracts)
PAYMENT_HUB_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
SETTLEMENT_CONTRACT_ID=CA3D5KRYMCMGRKWP74GS652UP2WOGS63KAODURZZJJNVHUB3K2IOZRNQ

# Security & Admin Keys
ADMIN_API_KEY=stellar-staging-admin-secret-test-key-2026
WEBHOOK_SIGNING_SECRET=staging-webhook-secret-hmac-sha256-key

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
SSE_KEEP_ALIVE_INTERVAL_MS=15000

# Diagnostic & Observability
LOG_LEVEL=debug
ENABLE_PROMETHEUS_METRICS=true
